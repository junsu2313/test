<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#000000" />
  <title>0728-0 Live View Design Lab</title>
  <style>
    :root { color-scheme: dark; font: 500 16px/1.45 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background:#050505; color:#f5f5f5; }
    * { box-sizing:border-box; }
