<body>
  <main>
    <header class="lab-header"><div><h1>0728-0 DESIGN LAB</h1><p>AF button study · design only · no camera command</p></div><span class="lab-meta">Landscape HUD / 01</span></header>
    <section class="preview-stage" aria-label="라이브뷰 디자인 미리보기"><div class="preview-target"></div></section>
    <section class="af-grid" aria-label="AF 버튼 디자인 5종">
      <article class="af-card is-selected"><h2>01 / OPTICAL</h2><p>광학 링과 초점면을 강조한 HUD형</p><button class="af-button af-optical" data-design="Optical ring"><span>AF</span><small>FOCUS</small></button></article>
      <article class="af-card"><h2>02 / GLASS</h2><p>셀로판지처럼 얹히는 유리 레이어형</p><button class="af-button af-glass" data-design="Glass lens"><span>AF</span><small>TOUCH</small></button></article>
      <article class="af-card"><h2>03 / RADAR</h2><p>십자선과 거리감을 가진 탐색형</p><button class="af-button af-radar" data-design="Radar cross"><span>AF</span><small>SCAN</small></button></article>
      <article class="af-card"><h2>04 / PRECISION</h2><p>최소한의 선으로 정확성을 표현한 형</p><button class="af-button af-crosshair" data-design="Precision mark"><span>AF</span><small>LOCK</small></button></article>
      <article class="af-card"><h2>05 / DIAL</h2><p>카메라 물리 다이얼을 연상시키는 형</p><button class="af-button af-dial" data-design="Dial control"><span>AF</span><small>SET</small></button></article>
    </section>
    <div id="afStatus" class="af-status" aria-live="polite">Selected: Optical ring</div>
    <a class="lab-link" href="/remote-ui/0716-landscape-1.1.html?designLab=0728-0">Open current landscape base</a>
  </main>
  <script>
    document.querySelectorAll(".af-button").forEach((button) => {
      button.addEventListener("click", () => {
        document.querySelectorAll(".af-card").forEach((card) => card.classList.remove("is-selected"));
        button.closest(".af-card").classList.add("is-selected");
        document.getElementById("afStatus").textContent = `Selected: ${button.dataset.design}`;
      });
    });
  </script>
  <script>
    document.body.innerHTML = '<main class="liveview-only" aria-label="Live view design canvas"><img id="liveFrame" class="liveview-frame" alt="Live view"></main>';
    const liveFrame = document.getElementById("liveFrame");
    const LIVEVIEW_URL = "/cgi-bin/liveview-v21";
    let frameBusy = false;
    let frameObjectUrl = "";
    function placeholder() {
      liveFrame.src = "data:image/svg+xml;utf8," + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900"><rect width="1600" height="900" fill="#050505"/><circle cx="800" cy="450" r="150" fill="none" stroke="#1c1c1c"/><circle cx="800" cy="450" r="4" fill="#777"/></svg>');
    }
    async function requestFrame() {
      if (frameBusy) return;
      frameBusy = true;
      try {
        const response = await fetch(`${LIVEVIEW_URL}?ts=${Date.now()}`, { cache:"no-store", headers:{"X-D810-Client":"0728-0-design-lab"} });
        if (!response.ok) throw new Error(`frame_${response.status}`);
        const objectUrl = URL.createObjectURL(await response.blob());
        const oldUrl = frameObjectUrl;
        frameObjectUrl = objectUrl;
        liveFrame.onload = () => { if (oldUrl) URL.revokeObjectURL(oldUrl); };
        liveFrame.src = objectUrl;
      } catch (_) {
        // Keep the canvas clean while the live-view stream recovers.
      } finally {
        frameBusy = false;
        window.setTimeout(requestFrame, 120);
      }
    }
    async function requestJson(url) {
      return fetch(url, {
        cache:"no-store",
        headers:{
          "X-D810-Client":"ui-flat",
          "X-D810-Event":url.includes("action") ? "action" : "boot",
          "X-D810-Trace":`${Date.now().toString(36)}-0728-0`
        }
      }).then((response) => response.json());
    }
    async function startDesignLiveView() {
      const boot = `?boot=${Date.now().toString(36)}-0728-0`;
      await requestJson(`/cgi-bin/session-manager${boot}`).catch(() => null);
      await requestJson("/cgi-bin/action-v21?action=live-on").catch(() => null);
      await requestJson("/cgi-bin/action-v21?action=live-fallback").catch(() => null);
      requestFrame();
    }
    placeholder();
    startDesignLiveView();
  </script>
  <script>
    document.body.innerHTML = '<iframe class="landscape-source" title="Live view" src="/remote-ui/0716-landscape-1.1.html?designLab=0728-0"></iframe>';
    document.body.insertAdjacentHTML("beforeend", '<section class="button-lab" aria-label="AF button design inventory">' + Array.from({length:11}, (_, index) => {
      const number = String(index + 1).padStart(2, "0");
      const slider = index === 10;
      return `<article class="button-study${slider ? " slide-study" : ""}${index === 0 ? " is-selected" : ""}"><div class="inventory-top"><b>AF ${number}</b><button class="study-hide" type="button" data-hide-study aria-label="Hide AF ${number}">×</button></div><button class="study-button ${slider ? "slide-button" : `design-${number}`}" type="button" aria-label="AF design ${number}"><span>AF</span>${slider ? "<i>→</i>" : ""}</button></article>`;
    }).join("") + '</section>');
    const inventory = document.querySelector(".button-lab");
    const inventoryItems = Array.from(inventory.querySelectorAll(".button-study"));
    const buttonGroup = document.createElement("div");
    const sliderGroup = document.createElement("div");
    buttonGroup.className = "inventory-group";
    sliderGroup.className = "inventory-group";
    buttonGroup.innerHTML = '<span class="inventory-group-label">BUTTON</span>';
    sliderGroup.innerHTML = '<span class="inventory-group-label">SLIDER</span>';
    inventoryItems.forEach((item, index) => (index < 10 ? buttonGroup : sliderGroup).appendChild(item));
    inventory.replaceChildren(buttonGroup, sliderGroup);
    document.body.insertAdjacentHTML("beforeend", '<div class="placement-layer" aria-label="Placed button canvas"></div>');
    const placementLayer = document.querySelector(".placement-layer");
    function placeInventoryItem(item, x, y) {
      if (!item || item.classList.contains("is-placed")) return;
      const sourceButton = item.querySelector(".study-button");
      const placed = document.createElement("div");
      placed.className = "placed-item";
      placed.style.left = `${x}px`;
      placed.style.top = `${y}px`;
      const clone = sourceButton.cloneNode(true);
      clone.removeAttribute("aria-label");
      const remove = document.createElement("button");
      remove.className = "placed-remove";
      remove.type = "button";
      remove.textContent = "x";
      remove.setAttribute("aria-label", "Delete placed button");
      const label = document.createElement("span");
      label.textContent = item.querySelector(".inventory-top b")?.textContent || "PLACED";
      placed.append(clone, remove, label);
      placementLayer.appendChild(placed);
      item.classList.add("is-placed");
      remove.addEventListener("click", () => { placed.remove(); item.classList.remove("is-placed"); });
      let moveId = null;
      placed.addEventListener("pointerdown", (event) => { moveId = event.pointerId; placed.setPointerCapture(event.pointerId); });
      placed.addEventListener("pointermove", (event) => { if (event.pointerId === moveId) { placed.style.left = `${event.clientX}px`; placed.style.top = `${event.clientY}px`; } });
      placed.addEventListener("pointerup", () => { moveId = null; });
    }
    inventory.style.display = "none";
    const initialPositions = [[10,24],[28,24],[46,24],[64,24],[82,24],[10,52],[28,52],[46,52],[64,52],[82,52],[50,76]];
    inventoryItems.forEach((item, index) => {
      // Keep AF02-AF10 in the source inventory for later studies, but hide them from this pass.
      if (index !== 0 && index !== 10) return;
      const position = initialPositions[index] || [50,50];
      placeInventoryItem(item, window.innerWidth * position[0] / 100, window.innerHeight * position[1] / 100);
    });
    inventoryItems.forEach((item) => {
      const sourceButton = item.querySelector(".study-button");
      sourceButton.addEventListener("pointerdown", (event) => { sourceButton.dataset.dragX = String(event.clientX); sourceButton.dataset.dragY = String(event.clientY); });
      sourceButton.addEventListener("pointerup", (event) => {
        const startX = Number(sourceButton.dataset.dragX || event.clientX);
        const startY = Number(sourceButton.dataset.dragY || event.clientY);
        if (Math.hypot(event.clientX - startX, event.clientY - startY) > 12 && event.clientY < window.innerHeight - 180) placeInventoryItem(item, event.clientX, event.clientY);
      });
    });
    let activeInventoryDrag = null;
    inventoryItems.forEach((item) => {
      const sourceButton = item.querySelector(".study-button");
      sourceButton.addEventListener("pointerdown", (event) => { activeInventoryDrag = { item, x: event.clientX, y: event.clientY }; });
    });
    document.addEventListener("pointerup", (event) => {
      if (!activeInventoryDrag) return;
      const drag = activeInventoryDrag;
      activeInventoryDrag = null;
      if (Math.hypot(event.clientX - drag.x, event.clientY - drag.y) > 12 && event.clientY < window.innerHeight - 180) placeInventoryItem(drag.item, event.clientX, event.clientY);
    });
    document.querySelectorAll("[data-hide-study]").forEach((hideButton) => {
      hideButton.addEventListener("click", (event) => {
        event.stopPropagation();
        hideButton.closest(".button-study").classList.toggle("is-hidden");
      });
    });
    document.querySelectorAll(".study-button").forEach((button) => {
      button.addEventListener("click", () => {
        document.querySelectorAll(".button-study").forEach((study) => study.classList.remove("is-selected"));
        button.closest(".button-study").classList.add("is-selected");
      });
    });
    const slideButton = document.querySelector(".slide-button");
    if (slideButton) {
      let slideStartX = 0;
      let slideX = 0;
      let slidePointerId = null;
      slideButton.addEventListener("pointerdown", (event) => {
        slidePointerId = event.pointerId;
        slideStartX = event.clientX - slideX;
        slideButton.classList.add("is-dragging");
        slideButton.setPointerCapture(event.pointerId);
      });
      slideButton.addEventListener("pointermove", (event) => {
        if (event.pointerId !== slidePointerId) return;
        const slideMax = Number.parseInt(getComputedStyle(slideButton).getPropertyValue("--slide-max"), 10) || 74;
        slideX = Math.max(0, Math.min(slideMax, event.clientX - slideStartX));
        slideButton.style.setProperty("--slide-x", `${slideX}px`);
        slideButton.classList.toggle("is-ready", slideX >= 38);
      });
      const finishSlide = () => {
        slidePointerId = null;
        slideButton.classList.remove("is-dragging");
        const slideMax = Number.parseInt(getComputedStyle(slideButton).getPropertyValue("--slide-max"), 10) || 74;
        if (slideX >= slideMax * 0.78) {
          slideButton.querySelector("span").textContent = "SHOT";
          window.setTimeout(() => { slideX = 0; slideButton.style.setProperty("--slide-x", "0px"); slideButton.classList.remove("is-ready"); slideButton.querySelector("span").textContent = "AF"; }, 420);
        } else {
          slideX = 0;
          slideButton.style.setProperty("--slide-x", "0px");
          slideButton.classList.remove("is-ready");
        }
      };
      slideButton.addEventListener("pointerup", finishSlide);
      slideButton.addEventListener("pointercancel", finishSlide);
    }
    const landscapeSource = document.querySelector(".landscape-source");
    landscapeSource.addEventListener("load", () => {
      const sourceDocument = landscapeSource.contentDocument;
      if (!sourceDocument) return;
      sourceDocument.querySelectorAll(".topbar, .control-card, .hidden-status, .landscape-exit, .landscape-layout-tools, .landscape-control-stage, .overlay-badge, .shot-preview, .shot-viewer").forEach((node) => { node.style.display = "none"; node.style.pointerEvents = "none"; });
      const settingsOverlay = sourceDocument.querySelector("#landscapeSettingsOverlay");
      if (settingsOverlay) {
        settingsOverlay.hidden = false;
        settingsOverlay.classList.add("is-open");
        settingsOverlay.style.display = "block";
        settingsOverlay.style.pointerEvents = "auto";
      }
      const sourceApp = sourceDocument.querySelector(".app");
      if (sourceApp) { sourceApp.style.cssText = "width:100vw;height:100dvh;min-height:100dvh;display:block;padding:0;background:#000;"; }
      const sourcePreview = sourceDocument.querySelector(".preview-card");
      if (sourcePreview) { sourcePreview.style.cssText = "position:fixed;inset:0;width:100vw;height:100dvh;min-height:0;border:0;background:#000;"; }
      const sourceFrame = sourceDocument.querySelector(".preview-frame");
      if (sourceFrame) {
        sourceFrame.style.cssText = "width:100%;height:100%;min-height:0;object-fit:contain;object-position:center;background:#000;";
        if (sourceFrame.src.startsWith("data:image")) {
          sourceFrame.src = "data:image/svg+xml;utf8," + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1067"><defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#141414"/><stop offset="50%" stop-color="#090909"/><stop offset="100%" stop-color="#1c1c1c"/></linearGradient></defs><rect width="1600" height="1067" fill="url(#bg)"/><circle cx="310" cy="850" r="240" fill="rgba(255,255,255,0.04)"/><circle cx="1280" cy="180" r="160" fill="rgba(255,255,255,0.06)"/><rect x="82" y="302" width="1436" height="572" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="4"/></svg>');
        }
      }
      sourceDocument.documentElement.style.cssText = "width:100%;height:100%;overflow:hidden;background:#000;";
      sourceDocument.body.style.cssText = "width:100%;height:100%;margin:0;padding:0;overflow:hidden;background:#000;";
    });
  </script>
</body>
</html>
