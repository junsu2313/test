    .slide-button.is-ready::after { background:rgba(150,235,190,.28); }
    .placement-layer { position:fixed; inset:0; z-index:3; pointer-events:auto; }
    .placement-hint { position:absolute; top:14px; left:50%; transform:translateX(-50%); padding:7px 11px; border:1px dashed rgba(255,255,255,.22); border-radius:999px; color:rgba(255,255,255,.42); background:rgba(0,0,0,.28); font:700 9px/1 system-ui,sans-serif; letter-spacing:.1em; text-transform:uppercase; pointer-events:none; }
    .placed-item { position:absolute; display:grid; justify-items:center; gap:5px; transform:translate(-50%,-50%); color:#fff; font:700 9px/1 system-ui,sans-serif; letter-spacing:.08em; text-transform:uppercase; cursor:move; touch-action:none; }
    .placed-item .study-button { flex:none; }
    .placed-remove { position:absolute; top:-7px; right:-9px; z-index:2; width:18px; height:18px; padding:0; border:1px solid rgba(255,255,255,.35); border-radius:50%; color:#fff; background:rgba(0,0,0,.72); font:700 11px/1 system-ui,sans-serif; }
    .button-study.is-placed { opacity:.35; filter:grayscale(.7); }
    .design-01::before { inset:10px; border:1px solid rgba(255,255,255,.82); border-radius:50%; box-shadow:0 0 0 7px rgba(255,255,255,.05), 0 0 0 15px rgba(255,255,255,.025); }
    .design-01::after { display:none; }
    .design-02 { border:1px solid rgba(255,255,255,.3); border-radius:22px; background:linear-gradient(145deg,rgba(255,255,255,.2),rgba(255,255,255,.03)); box-shadow:inset 0 1px rgba(255,255,255,.28),0 10px 22px rgba(0,0,0,.32); backdrop-filter:blur(8px); }
    .design-02::before { inset:7px; border:1px solid rgba(255,255,255,.13); border-radius:16px; }
    .design-03 { border-radius:50%; background:#151515; box-shadow:inset 0 -5px 0 rgba(0,0,0,.48),inset 0 1px 0 rgba(255,255,255,.16),0 8px 14px rgba(0,0,0,.38); }
    .design-03::before { inset:7px; border:1px solid rgba(255,255,255,.16); border-radius:50%; }
    .design-04 { border:1px solid rgba(255,255,255,.46); background:linear-gradient(90deg,transparent 49%,rgba(255,255,255,.24) 50%,transparent 51%),linear-gradient(0deg,transparent 49%,rgba(255,255,255,.24) 50%,transparent 51%); }
    .design-04::before { inset:16px; border:1px solid rgba(255,255,255,.64); border-radius:50%; }
