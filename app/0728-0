    .study-hide { width:18px; height:18px; padding:0; border:1px solid rgba(255,255,255,.2); border-radius:50%; color:rgba(255,255,255,.72); background:rgba(0,0,0,.36); font:700 11px/1 system-ui,sans-serif; cursor:pointer; }
    .button-study.is-hidden { color:rgba(255,255,255,.3); }
    .button-study.is-hidden .study-button { opacity:.2; filter:grayscale(1); }
    .button-study.is-hidden::after { content:"HIDDEN"; position:absolute; margin-top:88px; color:rgba(255,255,255,.38); font-size:8px; letter-spacing:.12em; }
    .slide-study { flex-basis:150px; }
    .slide-button { width:123px; height:49px; --slide-max:74px; justify-content:flex-start; padding-left:11px; border:1px solid rgba(255,255,255,.34); border-radius:999px; background:linear-gradient(90deg,rgba(255,255,255,.08),rgba(255,255,255,.02)); overflow:hidden; }
    .slide-button::before { display:none; }
    .slide-button::after { left:var(--slide-x, 0px); top:2px; width:45px; height:45px; border:1px solid rgba(255,255,255,.7); border-radius:50%; background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.2),rgba(255,255,255,.03) 55%); transition:left 80ms ease,background 120ms ease; }
