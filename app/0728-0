    .af-button { position:relative; display:grid; place-items:center; width:100%; aspect-ratio:1; margin:16px 0 12px; border:0; color:#fff; background:transparent; cursor:pointer; touch-action:manipulation; }
    .af-button:active { transform:scale(.95); }
    .af-button span { position:relative; z-index:2; font-size:11px; font-weight:750; letter-spacing:.1em; }
    .af-button small { position:relative; z-index:2; margin-top:4px; color:rgba(255,255,255,.56); font-size:8px; letter-spacing:.12em; }
    .af-optical::before { content:""; position:absolute; inset:16%; border:1px solid rgba(255,255,255,.72); border-radius:50%; box-shadow:0 0 0 8px rgba(255,255,255,.035), 0 0 0 18px rgba(255,255,255,.025); }
    .af-optical::after { content:""; position:absolute; inset:3%; border:1px dashed rgba(255,255,255,.25); border-radius:50%; }
    .af-glass { border:1px solid rgba(255,255,255,.26); border-radius:22px; background:linear-gradient(145deg, rgba(255,255,255,.18), rgba(255,255,255,.025)); box-shadow:inset 0 1px rgba(255,255,255,.24), 0 14px 26px rgba(0,0,0,.24); backdrop-filter:blur(8px); }
    .af-glass::before { content:""; position:absolute; inset:7px; border:1px solid rgba(255,255,255,.12); border-radius:16px; }
    .af-radar { border:1px solid rgba(255,255,255,.32); background:linear-gradient(90deg, transparent 49%, rgba(255,255,255,.22) 50%, transparent 51%), linear-gradient(0deg, transparent 49%, rgba(255,255,255,.22) 50%, transparent 51%); }
    .af-radar::before { content:""; position:absolute; inset:18%; border:1px solid rgba(255,255,255,.62); border-radius:50%; }
    .af-radar::after { content:""; position:absolute; width:9px; height:9px; border:1px solid #fff; border-radius:50%; }
    .af-crosshair::before, .af-crosshair::after { content:""; position:absolute; background:rgba(255,255,255,.72); }
    .af-crosshair::before { width:100%; height:1px; }
    .af-crosshair::after { width:1px; height:100%; }
    .af-crosshair { border:1px solid rgba(255,255,255,.62); clip-path:polygon(0 0, 35% 0, 35% 8%, 8% 8%, 8% 35%, 0 35%, 0 65%, 8% 65%, 8% 92%, 35% 92%, 35% 100%, 0 100%, 0 65%, 100% 65%, 100% 35%, 65% 35%, 65% 8%, 92% 8%, 92% 35%, 100% 35%, 100% 65%, 92% 65%, 92% 92%, 65% 92%, 65% 100%, 35% 100%, 35% 92%, 8% 92%, 8% 65%, 0 65%); }
    .af-dial { border:1px solid rgba(255,255,255,.5); border-radius:50%; background:repeating-conic-gradient(from 0deg, rgba(255,255,255,.55) 0deg 2deg, transparent 2deg 18deg); mask:radial-gradient(circle, transparent 0 54%, #000 55%); }
    .af-dial::before { content:""; position:absolute; inset:27%; border:1px solid rgba(255,255,255,.62); border-radius:50%; background:#0b0b0b; }
    .af-status { min-height:20px; margin-top:18px; color:rgba(255,255,255,.52); font-size:11px; letter-spacing:.04em; }
    .lab-link { display:inline-flex; margin-top:24px; min-height:36px; align-items:center; padding:0 14px; border:1px solid rgba(255,255,255,.18); border-radius:999px; color:rgba(255,255,255,.72); text-decoration:none; background:rgba(255,255,255,.035); font-size:11px; }
    @media (max-width:780px) { .lab-header { display:block; } .lab-meta { display:block; margin-top:12px; } .af-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); } .af-card:last-child { grid-column:span 2; } }
    /* Live-view-only canvas. The design lab intentionally has no controls or status UI. */
    html, body { width:100%; height:100%; min-height:0; padding:0; overflow:hidden; background:#000; }
    body { display:block; }
    .liveview-only { position:fixed; inset:0; display:grid; place-items:center; overflow:hidden; background:#000; }
    .liveview-frame { width:100%; height:100%; object-fit:contain; object-position:center; display:block; background:#000; }
    .landscape-source { position:fixed; inset:0; width:100%; height:100%; border:0; display:block; background:#000; }
    .button-lab { position:fixed; z-index:4; left:0; right:0; bottom:0; display:grid; gap:8px; padding:14px max(18px, env(safe-area-inset-left)) max(18px, env(safe-area-inset-bottom)); overflow:hidden; background:linear-gradient(180deg, transparent, rgba(0,0,0,.9) 25%); }
    .inventory-group { display:flex; align-items:end; gap:10px; min-width:max-content; overflow-x:auto; padding-top:4px; }
    .inventory-group-label { position:sticky; left:0; z-index:2; align-self:stretch; display:grid; place-items:center; width:72px; color:rgba(255,255,255,.4); font:700 9px/1.2 system-ui,sans-serif; letter-spacing:.12em; writing-mode:vertical-rl; transform:rotate(180deg); background:linear-gradient(90deg,rgba(0,0,0,.82),transparent); }
    .button-study { position:relative; flex:0 0 116px; display:grid; justify-items:center; gap:8px; color:rgba(255,255,255,.62); font:600 9px/1.2 system-ui,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .study-button { position:relative; width:70px; height:70px; display:grid; place-items:center; border:0; color:#fff; background:transparent; cursor:pointer; touch-action:manipulation; }
