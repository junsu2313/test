    .design-05 { border:1px solid rgba(255,255,255,.68); clip-path:polygon(0 0,36% 0,36% 7%,7% 7%,7% 36%,0 36%,0 64%,7% 64%,7% 93%,36% 93%,36% 100%,0 100%,0 64%,100% 64%,100% 36%,64% 36%,64% 7%,93% 7%,93% 36%,100% 36%,100% 64%,93% 64%,93% 93%,64% 93%,64% 100%,36% 100%,36% 93%,7% 93%,7% 64%,0 64%); }
    .design-05::before { inset:18px; border:1px solid rgba(255,255,255,.54); border-radius:50%; }
    .design-06 { border:1px solid rgba(255,255,255,.48); border-radius:50%; background:radial-gradient(circle,rgba(255,255,255,.18) 0 7%,transparent 8% 35%,rgba(255,255,255,.08) 36% 37%,transparent 38%); }
    .design-06::before { inset:4px; border:1px solid rgba(255,255,255,.2); border-radius:50%; }
    .design-07 { border:1px solid rgba(183,235,255,.8); border-radius:14px; color:#d8f6ff; background:rgba(64,156,190,.12); box-shadow:0 0 18px rgba(76,191,236,.18),inset 0 0 14px rgba(76,191,236,.1); }
    .design-07::before { inset:8px; border:1px solid rgba(183,235,255,.38); border-radius:8px; }
    .design-08 { border:1px solid rgba(255,255,255,.54); border-radius:50%; background:repeating-conic-gradient(from 0deg,rgba(255,255,255,.65) 0deg 2deg,transparent 2deg 18deg); mask:radial-gradient(circle,transparent 0 54%,#000 55%); }
    .design-08::before { inset:21px; border:1px solid rgba(255,255,255,.5); border-radius:50%; background:#0b0b0b; }
    .design-09 { border:1px solid rgba(255,255,255,.2); border-radius:999px; background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,.025)); box-shadow:inset 0 1px rgba(255,255,255,.16); }
    .design-09::before { inset:7px 14px; border:1px solid rgba(255,255,255,.18); border-radius:999px; }
    .design-10 { border:1px solid rgba(255,255,255,.62); background:linear-gradient(90deg,transparent 49%,rgba(255,255,255,.3) 50%,transparent 51%),linear-gradient(0deg,transparent 49%,rgba(255,255,255,.3) 50%,transparent 51%); }
    .design-10::before { inset:13px; border:1px solid rgba(255,255,255,.7); }
    @media (max-width:700px) { .button-lab { padding-left:10px; padding-right:10px; } .button-study { flex-basis:94px; } .study-button { width:64px; height:64px; } .slide-study { flex-basis:132px; } .slide-button { width:110px; height:45px; --slide-max:65px; } .slide-button::after { width:41px; height:41px; } .slide-button > span { left:2px; width:41px; } .slide-button i { right:33px; } .placement-layer { inset:0; } }
  </style>
