    .preview-target::before, .preview-target::after { content:""; position:absolute; background:rgba(255,255,255,.52); }
    .preview-target::before { left:50%; top:-13px; width:1px; height:98px; transform:translateX(-50%); }
    .preview-target::after { top:50%; left:-13px; width:98px; height:1px; transform:translateY(-50%); }
